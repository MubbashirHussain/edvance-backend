// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum Role {
  USER
  SUPER_ADMIN
  SCHOOL_ADMIN
  SCHOOL_STAFF
  SCHOOL_STUDENT
  SCHOOL_PARENT
  SCHOOL_GUEST
  SCHOOL_TEACHER

  @@schema("public")
}

model Subject {
  id            String         @id @default(uuid())
  name          String
  code          String
  description   String?
  isActive      Boolean        @default(true) @map("is_active")
  schoolId      String         @map("school_id")
  school        School         @relation(fields: [schoolId], references: [id])
  classSubjects ClassSubject[] @relation("SubjectClasses")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("SubjectCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("SubjectUpdatedBy", fields: [updatedById], references: [id])

  @@unique([code, schoolId], name: "subject_code_school_unique")
  @@index([schoolId])
  @@map("subjects")
  @@schema("public")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION

  @@schema("public")
}

enum SchoolStatus {
  ACTIVE
  TRIAL
  PAUSED
  INACTIVE

  @@schema("public")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@schema("public")
}

enum SchoolPlan {
  FREE
  BASIC
  PREMIUM

  @@schema("public")
}

model School {
  id             String       @id @default(uuid())
  name           String       @unique
  domain         String       @unique
  logoUrl        String?      @map("logo_url")
  faviconUrl     String?      @map("favicon_url")
  primaryColor   String?      @map("primary_color")
  secondaryColor String?      @map("secondary_color")
  contactName    String?      @map("contact_name")
  contactEmail   String?      @map("contact_email")
  contactPhone   String?      @map("contact_phone")
  address        String?
  city           String?
  state          String?
  postalCode     String?      @map("postal_code")
  country        String?
  latitude       Decimal?
  longitude      Decimal?
  plan           SchoolPlan   @default(FREE)
  status         SchoolStatus @default(TRIAL)
  billingCycle   BillingCycle @default(MONTHLY) @map("billing_cycle")

  allowStudentsModule       Boolean @default(false) @map("allow_students_module")
  allowTeachersModule       Boolean @default(false) @map("allow_teachers_module")
  allowParentModule         Boolean @default(false) @map("allow_parent_module")
  allowFeeModule            Boolean @default(false) @map("allow_fee_module")
  allowAttendanceModule     Boolean @default(false) @map("allow_attendance_module")
  allowExamsModule          Boolean @default(false) @map("allow_exams_module")
  allowTimeTableModule      Boolean @default(false) @map("allow_time_table_module")
  allowCommunicationModule  Boolean @default(false) @map("allow_communication_module")
  allowReportsModule        Boolean @default(false) @map("allow_reports_module")
  allowSettingsModule       Boolean @default(false) @map("allow_settings_module")
  allowUserManagementModule Boolean @default(false) @map("allow_user_management_module")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Track who created this school
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("SchoolCreatedBy", fields: [createdById], references: [id])

  users     User[]
  students  Student[]
  parents   Parent[]
  addresses Address[]
  subjects  Subject[]
  classes   Class[]

  @@map("schools")
  @@schema("public")
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  password        String
  firstName       String     @default("") @map("first_name")
  middleName      String?    @map("middle_name")
  lastName        String     @default("") @map("last_name")
  role            Role       @default(USER)
  status          UserStatus @default(PENDING_VERIFICATION)
  deviceId        String?    @map("device_id")
  refreshToken    String?    @map("refresh_token")
  lastLogin       DateTime?  @map("last_login")
  emailVerified   Boolean    @default(false) @map("email_verified")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  phone           String?
  profileImage    String?    @map("profile_image")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  // School relation
  schoolId String? @map("school_id")
  school   School? @relation(fields: [schoolId], references: [id])

  // Track who created this user
  createdById String? @map("created_by_id")
  createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Relations for tracking created/updated records
  createdUsers          User[]          @relation("UserCreatedBy")
  createdSchools        School[]        @relation("SchoolCreatedBy")
  createdStudents       Student[]       @relation("StudentCreatedBy")
  updatedStudents       Student[]       @relation("StudentUpdatedBy")
  createdParents        Parent[]        @relation("ParentCreatedBy")
  updatedParents        Parent[]        @relation("ParentUpdatedBy")
  createdStudentParents StudentParent[] @relation("StudentParentCreatedBy")
  createdAddresses      Address[]       @relation("AddressCreatedBy")
  updatedAddresses      Address[]       @relation("AddressUpdatedBy")

  // Class-related relations
  classesTaught       Class[]        @relation("ClassTeacher")
  classSubjects       ClassSubject[]
  studentClassRecords StudentClass[] @relation("StudentClassCreatedBy")
  createdClasses      Class[]        @relation("ClassCreatedBy")
  updatedClasses      Class[]        @relation("ClassUpdatedBy")
  createdSubjects     Subject[]      @relation("SubjectCreatedBy")
  updatedSubjects     Subject[]      @relation("SubjectUpdatedBy")
  StudentClass        StudentClass[]

  @@map("users")
  @@schema("public")
}

// Class Management Enums
enum ClassStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED

  @@schema("public")
}

// Class Management Models
model Class {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  className       String   @map("class_name")
  classCode       String   @unique @map("class_code")
  academicYear    String   @map("academic_year")
  gradeLevel      String   @map("grade_level")
  section         String
  classTeacherId  String   @map("class_teacher_id")
  coTeachers      String[] @default([]) @map("co_teachers")
  capacity        Int
  currentStrength Int      @default(0) @map("current_strength")
  settings        Json
  isActive        Boolean  @default(true) @map("is_active")

  // Relations
  school       School          @relation(fields: [schoolId], references: [id])
  classTeacher User            @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  subjects     ClassSubject[]
  schedule     ClassSchedule[]
  students     StudentClass[]

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("ClassCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("ClassUpdatedBy", fields: [updatedById], references: [id])

  @@map("classes")
  @@schema("public")
}

model ClassSubject {
  id        String @id @default(uuid())
  classId   String @map("class_id")
  subjectId String @map("subject_id")
  teacherId String @map("teacher_id")

  // Relations
  class_  Class   @relation(fields: [classId], references: [id])
  subject Subject @relation("SubjectClasses", fields: [subjectId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("class_subjects")
  @@schema("public")
}

model ClassSchedule {
  id      String @id @default(uuid())
  classId String @map("class_id")
  day     String // Monday, Tuesday, etc.
  periods Json // Array of periods with time and subject info

  // Relations
  class_ Class @relation(fields: [classId], references: [id])

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([classId])
  @@map("class_schedules")
  @@schema("public")
}

model StudentClass {
  id        String      @id @default(uuid())
  studentId String      @map("student_id")
  classId   String      @map("class_id")
  status    ClassStatus @default(ACTIVE)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  leftAt    DateTime?   @map("left_at")

  // Relations
  student User  @relation(fields: [studentId], references: [id])
  class_  Class @relation(fields: [classId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("StudentClassCreatedBy", fields: [createdById], references: [id])

  @@unique([studentId, classId])
  @@index([classId])
  @@map("student_classes")
  @@schema("public")
}

// Student Management Models
enum Gender {
  MALE
  FEMALE
  OTHER

  @@schema("public")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED

  @@schema("public")
}

enum AddressType {
  PERMANENT
  CURRENT

  @@schema("public")
}

model Student {
  id          String   @id @default(uuid())
  // Basic Information
  studentId   String   @unique @map("student_id")
  admissionNo String   @unique @map("admission_no")
  rollNumber  String?  @map("roll_number")
  firstName   String   @map("first_name")
  middleName  String?  @map("middle_name")
  lastName    String   @map("last_name")
  dateOfBirth DateTime @map("date_of_birth")
  gender      Gender
  bloodGroup  String?  @map("blood_group")
  email       String?  @unique
  phone       String?
  photoUrl    String?  @map("photo_url")

  // Academic Information
  currentGrade  String        @map("current_grade")
  section       String
  admissionDate DateTime      @map("admission_date")
  status        StudentStatus @default(ACTIVE)

  // Relations
  schoolId  String          @map("school_id")
  school    School          @relation(fields: [schoolId], references: [id])
  parents   StudentParent[]
  addresses Address[]       @relation("StudentAddresses")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("StudentCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("StudentUpdatedBy", fields: [updatedById], references: [id])

  @@map("students")
  @@schema("public")
}

model Parent {
  id            String  @id @default(uuid())
  // Personal Information
  firstName     String  @map("first_name")
  middleName    String? @map("middle_name")
  lastName      String  @map("last_name")
  cnic          String? @unique
  email         String? @unique
  phone         String
  occupation    String?
  education     String? // Highest education level
  monthlyIncome Float?  @map("monthly_income")
  isAlive       Boolean @default(true) @map("is_alive")

  // Relations
  schoolId  String          @map("school_id")
  school    School          @relation(fields: [schoolId], references: [id])
  students  StudentParent[]
  addressId String?         @map("address_id")
  address   Address?        @relation(fields: [addressId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("ParentCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("ParentUpdatedBy", fields: [updatedById], references: [id])

  @@map("parents")
  @@schema("public")
}

model StudentParent {
  studentId    String  @map("student_id")
  student      Student @relation(fields: [studentId], references: [id])
  parentId     String  @map("parent_id")
  parent       Parent  @relation(fields: [parentId], references: [id])
  relationship String
  isPrimary    Boolean @default(false) @map("is_primary")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("StudentParentCreatedBy", fields: [createdById], references: [id])

  @@id([studentId, parentId])
  @@map("student_parents")
  @@schema("public")
}

model Address {
  id           String      @id @default(uuid())
  // Address Details
  addressLine1 String      @map("address_line1")
  addressLine2 String?     @map("address_line2")
  city         String
  state        String
  postalCode   String      @map("postal_code")
  country      String      @default("Pakistan")
  type         AddressType
  isCurrent    Boolean     @default(true) @map("is_current")

  // Relations
  parents   Parent[]
  studentId String?  @map("student_id")
  student   Student? @relation("StudentAddresses", fields: [studentId], references: [id])
  schoolId  String   @map("school_id")
  school    School   @relation(fields: [schoolId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("AddressCreatedBy", fields: [createdById], references: [id])
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation("AddressUpdatedBy", fields: [updatedById], references: [id])

  @@map("addresses")
  @@schema("public")
}
