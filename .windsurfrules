# .windsurfrules for edvances

[project]
name = "edvance"
tech_stack = ["NestJS", "Prisma", "PostgreSQL", "Supabase (optional)"]
validation = ["class-validator", "class-transformer"]
auth = "JWT via TokenService"
response_format = "ResponseService"

[structure.root]
files = [".env", ".gitignore", "README.md", "package.json", "eslint.config.mjs", "nest-cli.json", "tsconfig*.json", ".prettierrc"]

[structure.prisma]
schema = "prisma/schema.prisma"
output = "generated/prisma"

[structure.src]
main = "main.ts"
app_module = "app.module.ts"
app_controller = "app.controller.ts"
app_service = "app.service.ts"

[structure.common]
config = "common/config/env.config.ts"
services = ["token.service.ts", "encryption.service.ts", "response.service.ts"]
utils = "common/utils/validation.utils.ts"
middleware = ["auth.middleware.ts", "admin.middleware.ts"]

[structure.config]
prisma = ["prisma.module.ts", "prisma.service.ts"]
supabase = ["supabase.module.ts", "supabase.service.ts"]

[modules.auth]
files = ["auth.controller.ts", "auth.service.ts", "auth.module.ts"]
dtos = ["signin.dto.ts", "signup.dto.ts", "refresh-token.dto.ts", "auth-response.dto.ts", "userPreference.dto.ts"]
enums = ["role.enum.ts"]

[env.required]
keys = ["DATABASE_URL", "JWT_SECRET", "PORT", "NODE_ENV"]

[env.optional]
keys = ["JWT_EXPIRES_IN", "SUPABASE_URL", "SUPABASE_KEY"]

env_getters = ["databaseUrl", "jwtSecret", "jwtExpiresIn", "port", "nodeEnv", "isDevelopment", "isProduction", "isTest", "supabaseUrl", "supabaseKey"]

[prisma]
datasource = "postgresql"
models = ["Users", "UserPreferences", "Donations", "Volunteers", "HelpRequests", "Causes"]
enums = ["DonationType", "DonationStatus", "PaymentStatus", "Status", "AvailabilityStatus", "MediaType"]
service_behavior = "connect on init, disconnect on destroy"

typical_usage = [
  "this.prisma.users.findUnique({...})",
  "this.prisma.users.create({...})"
]

[supabase]
service = "SupabaseService"
required_env = ["SUPABASE_URL", "SUPABASE_KEY"]
error_behavior = "Throw if env missing"

[validation]
method = "DTO + class-validator"
nested = "class-transformer @Type"
utils = ["isValidEmail", "isValidPassword", "sanitizeString"]

[request_response]
controller_prefix = true
response_service = true
auth_response = "LoginResponseDTO(token, refrashToken, user)"
errors = ["BadRequest", "Conflict", "NotFound", "Unauthorized", "Forbidden", "InternalServerError"]

[auth_security.token_service]
methods = ["generateJWTToken", "verifyJWTToken", "decodeJWTToken"]

[auth_security.auth_middleware]
requires_header = "Authorization: Bearer <token>"
extracts = ["req.token", "req.user"]

[auth_security.admin_middleware]
requires = "role == ADMIN"

[module_wiring]
imports = ["ConfigModule", "SupabaseModule", "AuthModule", "PrismaModule", "UserModule", "CommonModule", "DonationModule", "VolunteerModule", "HelpRequestModule", "CausesModule"]

[coding_conventions]
- "Use DTOs for validation"
- "Keep controllers thin"
- "Use EnvConfigService instead of process.env"
- "Normalized responses via ResponseService"
- "Use enums for roles & statuses"
- "Prisma schema is the source of truth"
- "JWT payload contains userId, email, role"

[setup]
steps = [
  "Install deps: npm ci or npm install",
  "Configure .env",
  "Run npx prisma generate",
  "Run migrations/seed",
  "Start app"
]

[replication]
steps = [
  "Copy folder skeleton",
  "Copy src/common",
  "Copy prisma config and schema",
  "Add Supabase only if needed",
  "Set up EnvConfigService",
  "Create modules",
  "Apply middlewares",
  "Configure JWT",
  "Implement DTO validation"
]

[endpoints_examples]
[ endpoints_examples.auth_signup ]
method = "POST"
path = "/auth/signup"
process = ["validate SignupDto", "create Users + prefs", "return summary"]

[ endpoints_examples.auth_signin ]
method = "POST"
path = "/auth/signin"
process = ["validate SigninDto", "verify password", "issue token + refresh", "return LoginResponseDTO"]

[output.preferences]
prioritize_code_over_long_text = true
text_should_be_concise = true
avoid_unnecessary_explanations = true
token_efficiency = "Use tokens primarily for generating effective, high-quality code."
